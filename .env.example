# Run `npm run setup` to fill this in from the terminal (it writes .env.local). Or copy this file to .env.local and fill it by hand. On Vercel these are Environment Variables.
# Neon Postgres connection string (Vercel's Neon integration sets DATABASE_URL for you).
DATABASE_URL=
# Runtime model key from console.anthropic.com. Never paste it into a prompt.
ANTHROPIC_API_KEY=
# Any long random string; `openssl rand -base64 32` or let the setup prompt generate one.
AUTH_SECRET=
# Your email. On the first request this becomes the first admin (tier admin, all stores).
BOOTSTRAP_ADMIN=
# Temporary first password for the bootstrap admin; you change it after enrolling your authenticator.
BOOTSTRAP_PASSWORD=change-me-on-first-login
# Optional overrides
# ASK_MODEL=claude-opus-5
# ASK_TODAY=2026-09-05
# ASK_MOCK=1   # helpers only: answer with a fixed planner and no model call
